import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import joblib
from sklearn.metrics import mean_squared_error, mean_absolute_error
from pathlib import Path

from config import (CARPETA_NORM, CARPETA_VENTANAS,
                    COLS_EXCLUIR, VENTANA, PASO)

# ─────────────────────────────────────────────
# CARGAR MODELO ENTRENADO
# ─────────────────────────────────────────────
ruta_modelo = Path(r"C:\Users\nacho\OneDrive\Escritorio\UCLM AEROESPACIAL\TFG\CÓDIGOS\modelo_rf.pkl")

print("=" * 60)
print("CARGANDO MODELO RANDOM FOREST")
print("=" * 60)

rf = joblib.load(ruta_modelo)
print(f"\n  ✓ Modelo cargado correctamente")
print(f"  Total árboles: {rf.n_estimators}")
print(f"  Max depth:     {rf.max_depth}")


# ─────────────────────────────────────────────
# RECUPERAR NOMBRES DE SENSORES
# ─────────────────────────────────────────────
df_ref        = pd.read_csv(next(CARPETA_NORM.glob('*_dev_norm.csv')))
cols_sensores = [c for c in df_ref.columns if c not in COLS_EXCLUIR]
del df_ref

archivos_test = sorted(CARPETA_VENTANAS.glob('*_test_vent.npz'))
print(f"\n  Archivos test: {len(archivos_test)}")


# ══════════════════════════════════════════════
# BLOQUE 1 — Evaluación archivo a archivo
# ══════════════════════════════════════════════

print("\n" + "=" * 60)
print("BLOQUE 1: MÉTRICAS POR ARCHIVO")
print("=" * 60)


def nasa_score(y_real, y_pred):
    delta = y_pred - y_real
    score = np.sum(np.where(delta < 0,
                            np.exp(-delta / 13) - 1,
                            np.exp( delta / 10) - 1))
    return score


resultados = []

for archivo in archivos_test:
    print(f"\n  Evaluando {archivo.name}...")

    try:
        datos  = np.load(archivo)
        X_test = datos['X'].reshape(datos['X'].shape[0], -1)
        Y_test = datos['Y']

        Y_pred = rf.predict(X_test)

        rmse  = np.sqrt(mean_squared_error(Y_test, Y_pred))
        mae   = mean_absolute_error(Y_test, Y_pred)
        score = nasa_score(Y_test, Y_pred)

        resultados.append({
            'archivo'   : archivo.stem,
            'n_muestras': len(Y_test),
            'RMSE'      : round(rmse,  4),
            'MAE'       : round(mae,   4),
            'NASA_Score': round(score, 2)
        })

        print(f"  RMSE:       {rmse:.4f}")
        print(f"  MAE:        {mae:.4f}")
        print(f"  NASA Score: {score:.2f}")

        del X_test, Y_test, Y_pred, datos

    except Exception as e:
        print(f"  ⚠️  OMITIDO — {e}")
        continue


# ── Resumen global ──
df_resultados = pd.DataFrame(resultados)

print("\n" + "=" * 60)
print("RESUMEN GLOBAL DE MÉTRICAS")
print("=" * 60)
print(df_resultados.to_string(index=False))
print(f"\n  RMSE medio:       {df_resultados['RMSE'].mean():.4f}")
print(f"  MAE medio:        {df_resultados['MAE'].mean():.4f}")
print(f"  NASA Score total: {df_resultados['NASA_Score'].sum():.2f}")


# ══════════════════════════════════════════════
# BLOQUE 2 — Gráficas de evaluación
# ══════════════════════════════════════════════

print("\n" + "=" * 60)
print("BLOQUE 2: GRÁFICAS DE EVALUACIÓN")
print("=" * 60)

Y_test_total, Y_pred_total = [], []

for archivo in archivos_test:
    try:
        datos  = np.load(archivo)
        X_test = datos['X'].reshape(datos['X'].shape[0], -1)
        Y_test = datos['Y']
        Y_pred = rf.predict(X_test)
        Y_test_total.append(Y_test)
        Y_pred_total.append(Y_pred)
        del X_test, Y_test, Y_pred, datos
    except Exception as e:
        print(f"  ⚠️  {archivo.name} omitido — {e}")
        continue

Y_test_all = np.concatenate(Y_test_total)
Y_pred_all = np.concatenate(Y_pred_total)
errores    = Y_test_all - Y_pred_all

fig, axes = plt.subplots(1, 3, figsize=(18, 5))
fig.suptitle('Evaluación Random Forest — Dataset N-CMAPSS',
             fontsize=14, fontweight='bold')

# ── Gráfica 1 — Scatter RUL predicho vs real ──
lim = max(Y_test_all.max(), Y_pred_all.max())
axes[0].scatter(Y_test_all, Y_pred_all,
                alpha=0.1, s=1, color='steelblue')
axes[0].plot([0, lim], [0, lim],
             color='crimson', linewidth=1.5,
             linestyle='--', label='Predicción perfecta')
axes[0].set_xlabel('RUL real (ciclos)')
axes[0].set_ylabel('RUL predicho (ciclos)')
axes[0].set_title('RUL predicho vs RUL real')
axes[0].legend()
axes[0].grid(True, alpha=0.3)

# ── Gráfica 2 — Distribución del error ──
axes[1].hist(errores, bins=80,
             color='steelblue', edgecolor='none', alpha=0.8)
axes[1].axvline(x=0, color='crimson',
                linewidth=1.5, linestyle='--', label='Error = 0')
axes[1].axvline(x=errores.mean(), color='orange',
                linewidth=1.5, linestyle='--',
                label=f'Media = {errores.mean():.2f}')
axes[1].set_xlabel('Error (RUL real - RUL predicho)')
axes[1].set_ylabel('Frecuencia')
axes[1].set_title('Distribución del error')
axes[1].legend()
axes[1].grid(True, alpha=0.3)

# ── Gráfica 3 — Evolución temporal primer archivo test ──
datos_ej  = np.load(archivos_test[0])
X_ej      = datos_ej['X'].reshape(datos_ej['X'].shape[0], -1)
Y_ej_real = datos_ej['Y']
Y_ej_pred = rf.predict(X_ej)

axes[2].plot(Y_ej_real, color='steelblue',
             linewidth=0.8, label='RUL real', alpha=0.8)
axes[2].plot(Y_ej_pred, color='crimson',
             linewidth=0.8, label='RUL predicho', alpha=0.8)
axes[2].set_xlabel('Muestra temporal')
axes[2].set_ylabel('RUL (ciclos)')
axes[2].set_title(f'Evolución temporal\n{archivos_test[0].stem}')
axes[2].legend()
axes[2].grid(True, alpha=0.3)

del X_ej, Y_ej_real, Y_ej_pred, datos_ej

plt.tight_layout()
plt.savefig('evaluacion_random_forest.png', dpi=150, bbox_inches='tight')
plt.show()

print("\n✓ Evaluación completada.")
print("  Gráfica guardada: evaluacion_random_forest.png")


