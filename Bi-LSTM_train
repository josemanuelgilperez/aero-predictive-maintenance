# ── Función de validación mixta ──
def crear_validacion_mixta(archivos, fraccion=0.1, seed=42):
    """
    Crea un conjunto de validación tomando una fracción
    aleatoria de TODOS los archivos dev.
    """
    np.random.seed(seed)
    X_val_list, Y_val_list = [], []

    print("\n  Construyendo validación mixta...")
    for archivo in archivos:
        datos = np.load(archivo)
        n     = datos['X'].shape[0]
        idx   = np.random.choice(n, int(n * fraccion),
                                 replace=False)
        X_val_list.append(datos['X'][idx])
        Y_val_list.append(datos['Y'][idx])

        print(f"    {archivo.name}: "
              f"{int(n * fraccion)} muestras de {n}")
        del datos

    X_val = np.concatenate(X_val_list, axis=0).astype(np.float32)
    Y_val = np.concatenate(Y_val_list, axis=0).astype(np.float32)
    del X_val_list, Y_val_list

    return X_val, Y_val


