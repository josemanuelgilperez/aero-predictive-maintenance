# ─────────────────────────────────────────────
# FUNCIÓN DE PÉRDIDA HÍBRIDA
# ─────────────────────────────────────────────
def nasa_loss_hibrida(y_real, y_pred, alpha=0.5):
    """
    Combina MSE con la NASA Score asimétrica.
    
    alpha controla el balance:
      alpha=0 → solo MSE (simétrico)
      alpha=1 → solo NASA loss (asimétrico)
      alpha=0.5 → equilibrio (recomendado)
    """
    delta    = y_pred - y_real
    
    # Componente MSE
    mse_loss = tf.reduce_mean(tf.square(delta))
    
    # Componente asimétrica NASA
    nasa     = tf.where(
        delta < 0,
        tf.exp(-delta / 13.0) - 1.0,    # subestimación: suave
        tf.exp( delta / 10.0) - 1.0     # sobreestimación: severa
    )
    nasa_loss = tf.reduce_mean(nasa)
    
    return (1 - alpha) * mse_loss + alpha * nasa_loss


# ─────────────────────────────────────────────
# CONSTRUCTOR DE LA ARQUITECTURA Bi-LSTM
# ─────────────────────────────────────────────
def construir_bilstm(ventana, n_sensores, units, n_layers,
                     dropout, dense_units, learning_rate):
    
    modelo = keras.Sequential(name="BiLSTM_RUL")
    modelo.add(keras.Input(shape=(ventana, n_sensores)))
    
    for i in range(n_layers):
        return_seq = (i < n_layers - 1)
        
        modelo.add(layers.Bidirectional(
            layers.LSTM(units=units,
                        return_sequences=return_seq),
            name=f"bilstm_{i+1}"
        ))
        modelo.add(layers.Dropout(rate=dropout,
                                   name=f"dropout_{i+1}"))
    
    modelo.add(layers.Dense(dense_units,
                            activation='relu',
                            name='dense_1'))
    modelo.add(layers.Dense(1,
                            activation='linear',
                            name='output'))
    
    modelo.compile(
        optimizer = keras.optimizers.Adam(learning_rate=learning_rate),
        loss      = nasa_loss_hibrida,
        metrics   = ['mae']
    )
    
    return modelo


