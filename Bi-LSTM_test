# ─────────────────────────────────────────────
# DEFINICIÓN DE LA NASA LOSS HÍBRIDA
# ─────────────────────────────────────────────
# Necesaria para cargar el modelo correctamente
def nasa_loss_hibrida(y_real, y_pred, alpha=0.5):
    delta    = y_pred - y_real
    mse_loss = tf.reduce_mean(tf.square(delta))
    nasa     = tf.where(
        delta < 0,
        tf.exp(-delta / 13.0) - 1.0,
        tf.exp( delta / 10.0) - 1.0
    )
    nasa_loss = tf.reduce_mean(nasa)
    return (1 - alpha) * mse_loss + alpha * nasa_loss


