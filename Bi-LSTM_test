# ── Función NASA Score ──
def nasa_score(y_real, y_pred):
    delta = y_pred - y_real
    score = np.sum(np.where(delta < 0,
                            np.exp(-delta / 13) - 1,
                            np.exp( delta / 10) - 1))
    return score


