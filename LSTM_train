def construir_lstm(ventana, n_sensores, units, layers,
                   dropout, dense_units, learning_rate):
    """
    Construye y devuelve el modelo LSTM compilado.

    Parámetros:
    ───────────
    ventana       : longitud de la ventana temporal
    n_sensores    : número de sensores de entrada
    units         : neuronas por capa LSTM
    layers        : número de capas LSTM apiladas
    dropout       : fracción de neuronas desactivadas
    dense_units   : neuronas de la capa densa intermedia
    learning_rate : velocidad de aprendizaje del optimizador
    """

    modelo = keras.Sequential(name="LSTM_RUL")

    # ── Capa de entrada ──
    modelo.add(keras.Input(shape=(ventana, n_sensores)))

    # ── Capas LSTM apiladas ──
    for i in range(layers):
        return_seq = (i < layers - 1)  # True en todas menos la última
        modelo.add(layers_module.LSTM(
            units            = units,
            return_sequences = return_seq,
            name             = f"lstm_{i+1}"
        ))
        modelo.add(layers_module.Dropout(
            rate = dropout,
            name = f"dropout_{i+1}"
        ))

    # ── Capa densa intermedia ──
    modelo.add(layers_module.Dense(
        units      = dense_units,
        activation = 'relu',
        name       = 'dense_1'
    ))

    # ── Capa de salida ──
    modelo.add(layers_module.Dense(
        units      = 1,
        activation = 'linear',
        name       = 'output'
    ))

    # ── Compilación ──
    modelo.compile(
        optimizer = keras.optimizers.Adam(learning_rate=learning_rate),
        loss      = 'mse',
        metrics   = ['mae']
    )

    return modelo


# Renombrar layers para evitar conflicto con variable 'layers'
